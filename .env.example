# ---------------------------------------------------------------------------
# Brain Rush — build-time configuration
#
# Every value here is read by app.config.ts at prebuild/bundle time and exposed
# to the app through `Constants.expoConfig.extra`. Game logic never references
# an ad unit directly, so switching to production inventory is a pure config
# change: set the three IDs, flip ADS_USE_TEST_IDS to false, re-run prebuild.
# ---------------------------------------------------------------------------

# Leave unset (or "true") to use Google's official AdMob test units.
ADS_USE_TEST_IDS=true

# Production AdMob identifiers (only honoured when ADS_USE_TEST_IDS=false).
ADMOB_APP_ID=ca-app-pub-0000000000000000~0000000000
ADMOB_INTERSTITIAL_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_REWARDED_ID=ca-app-pub-0000000000000000/0000000000
